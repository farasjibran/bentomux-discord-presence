{
  "id": "discord-presence.discord-rp",
  "name": "Discord Rich Presence",
  "version": "1.1.0",
  "apiVersion": 1,
  "description": "Show the active Bentomux workspace, git branch and agent status on your Discord profile. Turn the workspace line off from Settings if you would rather not share where you are.",
  "author": "farrasjibran",
  "entry": "index.js",
  "icon": { "type": "builtin", "name": "chat" },
  "permissions": [
    "app.read",
    "git.read",
    "storage",
    "backend.invoke",
    "discord.write"
  ],
  "contributes": {
    "commands": [
      { "id": "discord-presence.discord-rp.toggle", "title": "Discord Presence: Start / Stop" },
      { "id": "discord-presence.discord-rp.refresh", "title": "Discord Presence: Refresh now" }
    ],
    "settings": [
      { "id": "discord-presence.discord-rp.settings", "title": "Discord Presence" }
    ],
    "services": [
      { "id": "discord-presence.discord-rp.service", "title": "Discord Presence worker" }
    ]
  }
}